PORT=3000
# Local only: no Meta calls; unsigned mock payloads accepted on loopback.
LOCAL_TEST_MODE=false
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
# Meta app secret is required to authenticate webhook signatures.
META_APP_SECRET=
# Explicitly pinned supported Instagram Graph API version; update after testing.
META_API_VERSION=v22.0
